# Process environment variables take precedence over nonempty .env values.
# Required: an OpenAI-compatible endpoint supporting /models and tool calling.
LLM_MODEL_NAME=replace-with-your-model
LLM_BASE_URL=https://replace-with-your-endpoint/v1
LLM_API_KEY=replace-with-your-api-key

# Required local models. Current implementation requires a CUDA-capable NVIDIA GPU.
EMBEDDING_MODEL_PATH=E:/path/to/local/embedding-model
RERANKER_MODEL_PATH=E:/path/to/local/reranker-model
# Optional third recall route. Empty disables it; never mix its vectors into Chroma.
MULTILINGUAL_EMBEDDING_MODEL_PATH=

CHROMA_PERSIST_DIRECTORY=data/chroma
CHROMA_COLLECTION_NAME=med_evidence
POSTGRESQL_URL=postgresql+asyncpg://postgres:your-password@127.0.0.1:5432/med_evidence_agentic_rag
REDIS_URL=redis://127.0.0.1:6379/0

# Generate separate, private values. JWT secret must contain at least 32 bytes.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_CODE=
ADMIN_ACCESS_CODE=

# Optional integrations. Email login/email tool need SMTP; complex documents need MinerU.
MY_SENDER_EMAIL=
MY_SENDER_PASSWORD=
MINERU_TOKEN=

HYBRID_CANDIDATE_K=80
HYBRID_TOP_K=80
RERANKER_MIN_SCORE=0.5
RERANKER_INCLUDE_SOURCE=true
RERANKER_PRECISION=float16
